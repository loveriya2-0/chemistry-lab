  "sharedContent": {
    "fromBoard": "cbse",
    "basis": {
      "en": "The BSEH 2026-27 Chemistry course for Classes 11 and 12 lists the same units as the NCERT textbooks used for the CBSE content, so the source-checked NCERT notes and practice questions are reused. Classes 9–10 are not included yet. CBSE previous-year questions are not shared.",
      "hi": "BSEH 2026-27 के कक्षा 11 और 12 रसायन पाठ्यक्रम में वही इकाइयाँ हैं जो CBSE सामग्री में प्रयुक्त NCERT पाठ्यपुस्तकों में हैं, इसलिए स्रोत-जाँचे NCERT नोट्स और अभ्यास प्रश्न पुनः उपयोग किए गए हैं। कक्षा 9–10 अभी शामिल नहीं हैं। CBSE के पिछले वर्षों के प्रश्न साझा नहीं किए गए।",
      "hiSrc": "translated"
    },
