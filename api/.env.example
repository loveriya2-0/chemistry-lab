PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lab_console
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Comma separated list of allowed console origins
CORS_ORIGINS=http://localhost:5173
# Shared secret used by verifyPurchase (Firebase) to record purchases: POST /api/v1/internal/purchases
INTERNAL_SECRET=change-me-too
# Used by `npm run create-admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
# Path to the Flutter app content, used by `npm run seed`
CONTENT_DIR=../assets/content
