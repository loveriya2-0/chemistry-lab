{
  "name": "lab-console-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "containers": [
    { "class_name": "ApiContainer", "image": "./Dockerfile", "max_instances": 2, "instance_type": "basic" }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "ApiContainer", "name": "API" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }]
}
